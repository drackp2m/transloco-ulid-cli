{
	"name": "@drackp2m/transloco-ulid-cli",
	"version": "0.6.1",
	"description": "Checks, adds, exports and imports keys of a ULID-keyed Transloco catalogue, with XLIFF 2.0 round-trips for translators.",
	"author": "Marc Jovaní González",
	"license": "MIT",
	"packageManager": "pnpm@12.18.0",
	"homepage": "https://github.com/drackp2m/transloco-ulid-cli#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/drackp2m/transloco-ulid-cli.git"
	},
	"bugs": {
		"url": "https://github.com/drackp2m/transloco-ulid-cli/issues"
	},
	"keywords": [
		"transloco",
		"i18n",
		"ulid",
		"xliff",
		"icu",
		"angular"
	],
	"bin": {
		"transloco-ulid": "./bin/transloco-ulid.mjs"
	},
	"exports": {
		".": "./src/api.mjs",
		"./*": "./src/*"
	},
	"files": [
		"bin",
		"src",
		"!src/**/*.test.mjs",
		"!src/testing"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"prepare": "husky",
		"test": "node scripts/test.mjs",
		"test:coverage": "c8 node scripts/test.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@messageformat/parser": "5.1.1"
	},
	"peerDependencies": {
		"typescript": ">=5.0.0"
	},
	"devDependencies": {
		"@semantic-release/changelog": "7.0.0",
		"@semantic-release/exec": "7.1.0",
		"@semantic-release/git": "11.0.1",
		"c8": "12.0.0",
		"commitizen": "4.3.2",
		"commitlint": "21.2.2",
		"conventional-changelog-conventionalcommits": "10.4.0",
		"cz-emoji": "1.3.2-canary.2",
		"husky": "9.1.7",
		"semantic-release": "25.0.9",
		"typescript": "6.0.3"
	}
}
