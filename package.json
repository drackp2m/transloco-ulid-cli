{
	"name": "@drackp2m/transloco-ulid-cli",
	"version": "0.2.0",
	"description": "Checks, adds, exports and imports keys of a ULID-keyed Transloco catalogue, with XLIFF 2.0 round-trips for translators.",
	"author": "Marc Jovaní González",
	"license": "MIT",
	"homepage": "https://github.com/drackp2m/transloco-ulid-cli#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/drackp2m/transloco-ulid-cli.git"
	},
	"bugs": {
		"url": "https://github.com/drackp2m/transloco-ulid-cli/issues"
	},
	"keywords": [
		"transloco",
		"i18n",
		"ulid",
		"xliff",
		"icu",
		"angular"
	],
	"bin": {
		"transloco-ulid": "./bin/transloco-ulid.mjs"
	},
	"exports": {
		"./*": "./src/*"
	},
	"files": [
		"bin",
		"src",
		"!src/**/*.test.mjs",
		"!src/testing"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "node --test"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@messageformat/parser": "5.1.1"
	},
	"peerDependencies": {
		"typescript": ">=5.0.0"
	},
	"devDependencies": {
		"typescript": "6.0.3"
	}
}
